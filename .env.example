# Sign-in (there is no sign-up; this is the only account)
APP_USERNAME=admin
APP_PASSWORD=change-me

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Shown on the PDF reports
OWNER_NAME=

# Timezone used for "today", the timer and reports
TZ_NAME=Asia/Dhaka

# Set to true when served over HTTPS (e.g. behind the Cloudflare tunnel)
COOKIE_SECURE=true

# Host port (bound to 127.0.0.1 only)
PORT=8000

# Cloudflare Tunnel token, only needed for: docker compose --profile tunnel up -d
TUNNEL_TOKEN=
